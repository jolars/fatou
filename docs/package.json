{
  "name": "fatou-docs",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "playground:wasm": "wasm-pack build ../crates/fatou-wasm --target web --release --out-dir ../../docs/src/public/playground/pkg -- --locked",
    "prepare:content": "node scripts/prepare-content.mjs",
    "dev": "pnpm playground:wasm && pnpm prepare:content && vitepress dev --host 127.0.0.1",
    "build": "pnpm playground:wasm && pnpm prepare:content && vitepress build && node scripts/publish-content.mjs && node scripts/check-site.mjs",
    "preview": "vitepress preview --host 127.0.0.1",
    "preview:worker": "wrangler dev --ip 127.0.0.1",
    "test": "node --test worker.test.mjs tests/playground-settings.test.mjs",
    "test:wasm": "node --test tests/playground-wasm.test.mjs",
    "check:worker": "node scripts/check-worker.mjs",
    "deploy:check": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "cheerio": "1.2.0",
    "vitepress": "1.6.4",
    "vue": "^3.5.13",
    "wrangler": "4.156.2"
  }
}
