(toplevel (for (iteration (in i (call-i 1 : 3))) (block (op= x + i))) (for (iteration (in i (call-i 1 : 3))) (block (call println i))) (for (iteration (in i xs)) (block y)) (for (iteration (in (tuple-p i j) (call zip a b))) (block (call f i j))) (for (iteration (in i (call-i 1 : 3)) (in j (call-i 1 : 4))) (block (call g i j))))
