# Devenv
.devenv*
devenv.local.nix
devenv.local.yaml

# direnv
.direnv

# pre-commit
.pre-commit-config.yaml

# Documentation dependencies and generated output.
/docs/node_modules
/docs/.vitepress/dist
/docs/.vitepress/cache
/docs/.vitepress/benchmarks.json
/docs/.wrangler
/docs/src/public/fatou.schema.json
/docs/src/public/install
/docs/src/public/install.ps1
/docs/.env*
/docs/.dev.vars*
/docs/worker.log

# Added by cargo

/target

# rust -----------------------------------------------

# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants Contains mutation testing data
**/mutants.out*/

# JuliaSyntax oracle triage report (regenerated by the ignored `oracle_full_report`
# test; allowlist.txt/blocked.txt are the source of truth).
/crates/fatou-parser/tests/oracle/report.txt

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/
/crates/fatou-parser/tests/oracle/juliasyntax-report.txt
/.task/checksum
/assets/fatou-logo.png
/assets/fatou-logo.svg
/assets/fatou-newton.png
/test.jl

# Benchmark corpus (fetched by bench/corpus/download.sh, pinned but not vendored)
# and per-tool intermediate outputs. bench/results.json is committed.
/bench/corpus/JuliaSyntax
/bench/corpus/DataFrames
/bench/corpus/manifest.json
/bench/*.tmp.json

# Profiler output (bench/profile.sh). A profile is a local observation, unlike
# bench/results.json, which is a tracked result the docs read.
/bench/profile.svg
/bench/profile.data
/bench/perf.data*

# Julia language-server environments for the memory benchmark, provisioned by
# bench/lsenv/setup.sh. Pinned in that script, not vendored. bench/memory.json
# is committed.
/bench/lsenv/languageserver
/bench/lsenv/jetls
/bench/lsenv/manifest.json
/bench/lsenv/*.log

# Python benchmark helpers.
__pycache__/
