{
  "$schema": "https://raw.githubusercontent.com/jolars/versionary/main/schemas/config.json",
  "version": 1,
  "release-type": "rust",
  "bump-minor-pre-major": true,
  "include-commit-authors": true,
  "release-reference-comments": "best-effort",
  "packages": {
    ".": {
      "exclude-paths": [
        "editors",
        "crates/fatou-parser",
        "crates/fatou-formatter",
        "crates/fatou-wasm"
      ],
      "extra-files": [
        {
          "type": "json",
          "path": "npm/fatou-cli/package.json",
          "field-path": "$.version"
        },
        {
          "type": "json",
          "path": "npm/fatou-cli/package.json",
          "field-path": "$.optionalDependencies.*"
        },
        {
          "type": "regex",
          "path": "flake.nix",
          "pattern": "pname = \"fatou\";\\n\\s*version = \"([^\"]+)\";"
        }
      ]
    },
    "crates/fatou-parser": {},
    "crates/fatou-formatter": {},
    "editors/code": {
      "release-type": "node",
      "package-name": "fatou-code",
      "follows": ["."]
    },
    // The Zed extension is submitted to `zed-industries/extensions` by hand, so
    // it deliberately does not `follow` the CLI: a release here means a registry
    // pull request, and tying it to every CLI release would leave the registry
    // permanently stale.
    "editors/zed": {
      "package-name": "fatou-zed",
      "extra-files": [
        {
          "type": "toml",
          "path": "extension.toml",
          "field-path": "$.version"
        },
        // `Cargo.lock` records the crate's own version, and nothing else keeps
        // it in step with `Cargo.toml`. The `--locked` build in CI is the
        // backstop if this rule ever stops matching.
        {
          "type": "regex",
          "path": "Cargo.lock",
          "pattern": "name = \"zed_fatou\"\\nversion = \"([^\"]+)\""
        }
      ]
    }
  },
  "commit-overrides": {
    "6499212a448e22626f4979720e65ea3847232d46": {
      "skip": true
    },
    "e403d1a153695c644687983a2f06fa656b591d69": {
      "skip": true
    },
    "5f40ccd1cbba82060cc15a6bd299dda16b8ca160": {
      "skip": true
    }
  }
}
